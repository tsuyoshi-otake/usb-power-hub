*.log

# Python bytecode from verification tools
__pycache__/
*.py[cod]

# Firmware build output
firmware/build/

# Host app build output (Cargo, issue #9)
host/profiler/target/

# Disposable candidate exports (CLAUDE.md Section 2: never orderable).
# Approved releases live under manufacturing/releases/ and stay tracked.
manufacturing/working/*

# Goal-loop working files (rubric, verdicts) are session artifacts, as in the
# sibling repositories. Distilled learnings live in .claude/memory/, which is tracked.
.claude/goal-loop/
